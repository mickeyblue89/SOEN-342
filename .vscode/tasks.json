{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven Compile",
      "type": "process",
      "command": "mvn",
      "args": [
        "-f",
        "${workspaceFolder}/Code/pom.xml",
        "compile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Maven Run",
      "type": "process",
      "command": "mvn",
      "args": [
        "-f",
        "${workspaceFolder}/Code/pom.xml",
        "exec:java"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
