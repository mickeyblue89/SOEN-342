{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Java",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/compile-java.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
